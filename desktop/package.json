{
  "name": "@atelier/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Atelier Windows desktop shell (Tauri + Node sidecar)",
  "type": "module",
  "scripts": {
    "icons": "node scripts/make-icons.mjs && tauri icon assets/icon.png",
    "stage": "node scripts/stage.mjs",
    "dev": "node scripts/stage.mjs && tauri dev",
    "build": "node scripts/stage.mjs && tauri build",
    "build:release": "node scripts/stage.mjs && tauri build --config src-tauri/tauri.release.conf.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6"
  }
}
