{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atelier",
  "version": "0.1.13",
  "identifier": "com.atelier.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Atelier",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#0d0d11",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/atelier-node"
    ],
    "resources": {
      "../server-dist/": "server/"
    },
    "shortDescription": "Atelier: Design-to-Ship Studio",
    "copyright": "Copyright © Atelier contributors",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDMjEwNTZEM0RFOEMzREYKUldUZncrZzliUVVoYktLQXVKSFlFRS9ndGh6MmlmaXZFZ0N1eXNZZTFlS2dPd3lWQzJZTVg3b1MK",
      "endpoints": [
        "https://github.com/mmonzera/atelier/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
