---
import GlassCard from "./GlassCard.astro";
import SectionHead from "./SectionHead.astro";
import "../styles/core.css";

interface BentoItem {
  tag?: string;
  title: string;
  body: string;
  visual?: string;
}

interface Props {
  bento: { eyebrow: string; title: string; body?: string; items: BentoItem[] };
}
const { bento } = Astro.props;
---
<section id="features" class="core-section bento" aria-labelledby="bento-title">
  <div class="core-shell">
    <SectionHead id="bento-title" eyebrow={bento.eyebrow} title={bento.title} body={bento.body} />

    <div class="bento__grid">
      {bento.items.map((item, i) => (
        <GlassCard as="article" class={`bento__card bento__card--${i + 1}`}>
          <div class="bento__visual" aria-hidden="true">
            {item.visual === "orbit" && (
              <svg viewBox="0 0 320 120" fill="none">
                <ellipse cx="160" cy="60" rx="120" ry="38" stroke="currentColor" stroke-opacity=".18" />
                <ellipse cx="160" cy="60" rx="78" ry="24" stroke="currentColor" stroke-opacity=".14" />
                <circle cx="160" cy="60" r="22" stroke="var(--agent-sand, #d8be92)" stroke-opacity=".35" />
                <circle cx="160" cy="60" r="11" fill="var(--agent-sand, #d8be92)" fill-opacity=".9" />
                <circle cx="280" cy="60" r="4" fill="var(--agent-sand, #d8be92)" />
                <circle cx="88" cy="40" r="3.5" fill="currentColor" fill-opacity=".5" />
                <circle cx="232" cy="82" r="3" fill="currentColor" fill-opacity=".4" />
              </svg>
            )}
            {item.visual === "threads" && (
              <svg viewBox="0 0 320 120" fill="none">
                <rect x="16" y="14" width="196" height="26" rx="13" fill="currentColor" fill-opacity=".06" />
                <rect x="28" y="24" width="88" height="6" rx="3" fill="currentColor" fill-opacity=".35" />
                <rect x="108" y="52" width="196" height="26" rx="13" fill="currentColor" fill-opacity=".06" />
                <rect x="120" y="62" width="120" height="6" rx="3" fill="currentColor" fill-opacity=".35" />
                <rect x="16" y="90" width="150" height="26" rx="13" fill="var(--agent-sand, #d8be92)" fill-opacity=".1" />
                <rect x="28" y="100" width="72" height="6" rx="3" fill="var(--agent-sand, #d8be92)" fill-opacity=".7" />
              </svg>
            )}
            {item.visual === "rings" && (
              <svg viewBox="0 0 320 120" fill="none">
                <circle cx="160" cy="60" r="46" stroke="currentColor" stroke-opacity=".14" />
                <circle cx="160" cy="60" r="34" stroke="currentColor" stroke-opacity=".2" />
                <circle cx="160" cy="60" r="22" stroke="var(--agent-sand, #d8be92)" stroke-opacity=".45" />
                <circle cx="160" cy="60" r="5" fill="var(--agent-sand, #d8be92)" />
                <path d="M160 14v8M160 98v8M114 60h8M198 60h8" stroke="currentColor" stroke-opacity=".25" />
              </svg>
            )}
            {item.visual === "control" && (
              <svg viewBox="0 0 320 120" fill="none">
                <rect x="30" y="34" width="260" height="10" rx="5" fill="currentColor" fill-opacity=".1" />
                <rect x="30" y="34" width="150" height="10" rx="5" fill="var(--agent-sand, #d8be92)" fill-opacity=".55" />
                <circle cx="180" cy="39" r="12" fill="var(--bg-base, #0d0d11)" stroke="var(--agent-sand, #d8be92)" />
                <rect x="30" y="76" width="260" height="10" rx="5" fill="currentColor" fill-opacity=".08" />
                <rect x="30" y="76" width="70" height="10" rx="5" fill="currentColor" fill-opacity=".25" />
                <circle cx="100" cy="81" r="9" fill="var(--bg-base, #0d0d11)" stroke="currentColor" stroke-opacity=".3" />
              </svg>
            )}
          </div>

          <div class="bento__text">
            <p class="bento__tag">{item.tag ?? String(i + 1).padStart(2, "0")}</p>
            <h3 class="bento__title">{item.title}</h3>
            <p class="bento__body">{item.body}</p>
          </div>
        </GlassCard>
      ))}
    </div>
  </div>
</section>
