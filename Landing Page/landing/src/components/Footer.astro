---
import "../styles/sections.css";

interface Link {
  label: string;
  href: string;
}
interface Props {
  closing: { title: string; body: string; cta: string };
  footer: { columns: { title: string; links: Link[] }[]; copyright: string; navLabel?: string };
  downloadHref: string;
}
const { closing, footer, downloadHref } = Astro.props;
---
<footer class="footer">
  <section class="closing" aria-labelledby="closing-title">
    <div class="closing__glow" aria-hidden="true"></div>
    <div class="core-shell closing__inner">
      <h2 id="closing-title" class="closing__title">{closing.title}</h2>
      <p class="closing__body">{closing.body}</p>
      <a class="btn btn-glow" href={downloadHref}>{closing.cta}</a>
    </div>
  </section>

  <div class="core-shell footer__inner">
    <nav class="footer__cols" aria-label={footer.navLabel ?? "Footer"}>
      {footer.columns.map((col) => (
        <div class="footer__col">
          <h3 class="footer__col-title">{col.title}</h3>
          <ul class="footer__links">
            {col.links.map((link) => (
              <li>
                {link.href ? (
                  <a href={link.href} rel={link.href.startsWith("http") ? "noopener" : undefined}>
                    {link.label}
                  </a>
                ) : (
                  <span class="footer__soon">{link.label}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <div class="footer__wordmark" aria-hidden="true">ATELIER</div>

    <p class="footer__copy">{footer.copyright}</p>
  </div>
</footer>
