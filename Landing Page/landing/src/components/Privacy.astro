---
import SectionHead from "./SectionHead.astro";
import "../styles/sections.css";

interface Point {
  title: string;
  body: string;
}
interface Props {
  privacy: { eyebrow: string; title: string; body?: string; points: Point[] };
}
const { privacy } = Astro.props;
---
<section id="privacy" class="core-section privacy" aria-labelledby="privacy-title">
  <div class="core-shell privacy__layout">
    <div class="privacy__visual" aria-hidden="true">
      <svg viewBox="0 0 320 320" fill="none">
        <circle cx="160" cy="160" r="138" stroke="currentColor" stroke-opacity=".1" />
        <circle cx="160" cy="160" r="106" stroke="currentColor" stroke-opacity=".14" />
        <circle cx="160" cy="160" r="74" stroke="currentColor" stroke-opacity=".18" />
        <circle cx="160" cy="160" r="42" stroke="var(--agent-sand, #d8be92)" stroke-opacity=".4" />
        <circle cx="160" cy="160" r="20" fill="var(--surface-2, #1c1c23)" stroke="var(--agent-sand, #d8be92)" stroke-opacity=".55" />
        <path d="M154 160v-5a6 6 0 0 1 12 0v5" stroke="var(--agent-sand, #d8be92)" stroke-width="1.6" />
        <rect x="152" y="160" width="16" height="11" rx="2.5" stroke="var(--agent-sand, #d8be92)" stroke-width="1.6" />
        <circle cx="160" cy="22" r="3" fill="var(--agent-sand, #d8be92)" fill-opacity=".7" />
        <circle cx="298" cy="160" r="2.5" fill="currentColor" fill-opacity=".45" />
        <circle cx="160" cy="298" r="2.5" fill="currentColor" fill-opacity=".35" />
        <circle cx="22" cy="160" r="2" fill="currentColor" fill-opacity=".3" />
      </svg>
    </div>

    <div class="privacy__content">
      <SectionHead id="privacy-title" eyebrow={privacy.eyebrow} title={privacy.title} body={privacy.body} />
      <ol class="privacy__points">
        {privacy.points.map((point, i) => (
          <li class="privacy__point" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <span class="privacy__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="privacy__point-title">{point.title}</h3>
              <p class="privacy__point-body">{point.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
