---
import SectionHead from "./SectionHead.astro";
import "../styles/sections.css";
import { RELEASE_REPO, type ReleaseInfo } from "../lib/releases";

interface Props {
  download: {
    eyebrow: string;
    title: string;
    body?: string;
    windows: string;
    versionLabel: string;
    sizeLabel: string;
    releasedLabel: string;
    cta: string;
    notPublished: string;
    releaseNotes: string;
    note: string;
    otherTitle: string;
    otherBody: string;
  };
  release: ReleaseInfo;
  downloadHref?: string;
  lang: "en" | "id";
}
const { download, release, downloadHref, lang } = Astro.props;

const installer =
  release.assets.find((a) => /\.(exe|msi)$/i.test(a.name)) ?? release.assets[0];
// downloadHref dari halaman bisa berupa "#download" saat rilis kosong; itu bukan tautan unduhan.
const href = installer?.url ?? (/^https?:/i.test(downloadHref ?? "") ? downloadHref : undefined);

const sizeLabel = installer
  ? `${(installer.size / 1024 / 1024).toFixed(1)} MB`
  : null;
const dateLabel = release.publishedAt
  ? new Intl.DateTimeFormat(lang === "id" ? "id-ID" : "en-GB", {
      day: "numeric",
      month: "short",
      year: "numeric",
    }).format(new Date(release.publishedAt))
  : null;
const notesHref = `https://github.com/${RELEASE_REPO}/releases`;
---
<section id="download" class="core-section download" aria-labelledby="download-title">
  <div class="core-shell">
    <SectionHead
      id="download-title"
      eyebrow={download.eyebrow}
      title={download.title}
      body={download.body}
      align="center"
    />

    <div class="download__grid">
      <article class="download__card download__card--primary">
        <div class="download__head">
          <h3 class="download__os">{download.windows}</h3>
          {release.source === "github" && <span class="download__badge">GitHub</span>}
        </div>

        {(release.version || sizeLabel || dateLabel) && (
          <dl class="download__meta">
            {release.version && (
              <div>
                <dt>{download.versionLabel}</dt>
                <dd>{release.version}</dd>
              </div>
            )}
            {sizeLabel && (
              <div>
                <dt>{download.sizeLabel}</dt>
                <dd>{sizeLabel}</dd>
              </div>
            )}
            {dateLabel && (
              <div>
                <dt>{download.releasedLabel}</dt>
                <dd>{dateLabel}</dd>
              </div>
            )}
          </dl>
        )}

        {href ? (
          <a class="btn btn-glow download__cta" href={href} rel="noopener">
            {download.cta}
          </a>
        ) : (
          <span class="btn btn-glow download__cta is-disabled" aria-disabled="true">
            {download.notPublished}
          </span>
        )}

        <p class="download__links">
          <a href={notesHref} rel="noopener">{download.releaseNotes}</a>
        </p>
        <p class="download__note">{download.note}</p>
      </article>

      {["macOS", "Linux"].map((os, i) => (
        <article class="download__card" data-reveal style={`--reveal-delay:${(i + 1) * 70}ms`}>
          <h3 class="download__os">{os}</h3>
          <p class="download__unavailable">{download.otherTitle}</p>
          <p class="download__other-body">{download.otherBody}</p>
        </article>
      ))}
    </div>
  </div>
</section>
