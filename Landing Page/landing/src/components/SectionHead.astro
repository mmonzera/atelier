---
import "../styles/core.css";

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  body?: string;
  align?: "start" | "center";
}

const { id, eyebrow, title, body, align = "start" } = Astro.props;
---
<header class:list={["sec-head", align === "center" && "sec-head--center"]}>
  {eyebrow && <p class="sec-head__eyebrow">{eyebrow}</p>}
  <h2 class="sec-head__title" id={id}>{title}</h2>
  {body && <p class="sec-head__body">{body}</p>}
</header>
