---
import SectionHead from "./SectionHead.astro";
import "../styles/sections.css";

interface Props {
  faq: { eyebrow: string; title: string; body?: string; items: { q: string; a: string }[] };
}
const { faq } = Astro.props;
---
<section id="faq" class="core-section faq" aria-labelledby="faq-title">
  <div class="core-shell faq__layout">
    <SectionHead id="faq-title" eyebrow={faq.eyebrow} title={faq.title} body={faq.body} />

    <div class="faq__list">
      {faq.items.map((item, i) => (
        <details class="faq__item" data-reveal style={`--reveal-delay:${i * 40}ms`}>
          <summary class="faq__q">
            <span>{item.q}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <p class="faq__a">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
