---
import "../styles/nav.css";
import { LOCALES, pathFor, getDict, type Locale } from "../lib/i18n";

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = getDict(lang).nav;
const links = [
  { id: "features", label: t.features },
  { id: "workflow", label: t.workflow },
  { id: "privacy", label: t.privacy },
  { id: "download", label: t.download },
  { id: "faq", label: t.faq },
];
---
<header class="nav" data-nav>
  <div class="nav-progress" aria-hidden="true"><span data-progress></span></div>
  <nav class="nav-pill glass" aria-label={t.mainNav}>
    <a class="nav-brand" href={pathFor(lang)} aria-label="Atelier">Atelier</a>

    <ul class="nav-links">
      {links.map((l) => (
        <li><a href={`#${l.id}`} data-spy={l.id}>{l.label}</a></li>
      ))}
    </ul>

    <div class="nav-actions">
      <div class="nav-lang" role="group" aria-label={t.langLabel}>
        {LOCALES.map((l) =>
          l === lang ? (
            <span class="is-active" aria-current="true" lang={l}>{l.toUpperCase()}</span>
          ) : (
            <a href={pathFor(l)} hreflang={l} lang={l} data-lang={l}>{l.toUpperCase()}</a>
          )
        )}
      </div>
      <a class="btn btn-glow nav-cta" href="#download">{t.cta}</a>
      <button
        class="nav-toggle" type="button" aria-expanded="false"
        aria-controls="nav-sheet" aria-label={t.menuOpen}
        data-open-label={t.menuOpen} data-close-label={t.menuClose}
      >
        <span class="nav-toggle-bars" aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  <div class="nav-sheet glass" id="nav-sheet" hidden>
    <ul>
      {links.map((l) => (
        <li><a href={`#${l.id}`} data-spy={l.id}>{l.label}</a></li>
      ))}
    </ul>
    <a class="btn btn-glow" href="#download">{t.cta}</a>
  </div>
</header>
