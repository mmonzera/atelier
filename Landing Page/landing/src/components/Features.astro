---
import SectionHead from "./SectionHead.astro";
import "../styles/core.css";

interface Feature {
  icon?: string;
  title: string;
  body: string;
}

interface Props {
  features: { eyebrow: string; title: string; body?: string; items: Feature[] };
}
const { features } = Astro.props;
---
<section class="core-section features" aria-labelledby="features-title">
  <div class="core-shell">
    <SectionHead id="features-title" eyebrow={features.eyebrow} title={features.title} body={features.body} />

    <svg class="features__sprite" aria-hidden="true" focusable="false">
      <symbol id="ic-keyboard" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="6" width="18" height="12" rx="2" />
        <path d="M7 10h.01M11 10h.01M15 10h.01M7 14h10" />
      </symbol>
      <symbol id="ic-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="6" />
        <path d="m20 20-4.5-4.5" />
      </symbol>
      <symbol id="ic-layers" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3 3 8l9 5 9-5-9-5Z" />
        <path d="m3 12 9 5 9-5" />
        <path d="m3 16 9 5 9-5" />
      </symbol>
      <symbol id="ic-file" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" />
        <path d="M14 3v5h5" />
      </symbol>
      <symbol id="ic-globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18" />
        <path d="M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" />
      </symbol>
      <symbol id="ic-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 3 7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z" />
        <path d="m9 12 2 2 4-4" />
      </symbol>
    </svg>

    <ul class="features__grid">
      {features.items.map((f, i) => (
        <li class="features__item" data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <svg class="features__icon" aria-hidden="true" focusable="false">
            <use href={`#ic-${f.icon ?? "layers"}`} />
          </svg>
          <h3 class="features__title">{f.title}</h3>
          <p class="features__body">{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
