---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Strip from "../components/Strip.astro";
import ScrollWords from "../components/ScrollWords.astro";
import Bento from "../components/Bento.astro";
import Features from "../components/Features.astro";
import Workflow from "../components/Workflow.astro";
import { getDict } from "../lib/i18n";
import { getRelease } from "../lib/releases";
const lang = "en" as const;
const t = getDict(lang);
const release = await getRelease();
const downloadHref = release.assets[0]?.url ?? "#download";
---
<Base lang={lang} title={t.meta.title} description={t.meta.description} skipLabel={t.a11y.skip}>
  <Nav slot="nav" lang={lang} />
  <Hero hero={t.hero} release={release} downloadHref={downloadHref} lang={lang} />
  <Strip strip={t.strip} />
  <ScrollWords text={t.scrollWords.text} accent={t.scrollWords.accent} label={t.scrollWords.label} />
  <Bento bento={t.bento} />
  <Features features={t.features} />
  <Workflow workflow={t.workflow} />
  <!-- Stub berid agar scroll-spy punya target; diganti section asli di AT-12. -->
  <section id="privacy" class="section-stub" aria-label={t.nav.privacy}></section>
  <section id="download" class="section-stub" aria-label={t.nav.download}></section>
  <section id="faq" class="section-stub" aria-label={t.nav.faq}></section>
</Base>
