---
import { ClientRouter } from "astro:transitions";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/motion.css";
import { LOCALES, pathFor, type Locale } from "../lib/i18n";

interface Props { lang: Locale; title: string; description: string; skipLabel: string; }
const { lang, title, description, skipLabel } = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(pathFor(lang), site).href : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {site && LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l), site).href} />)}
    {site && <link rel="alternate" hreflang="x-default" href={new URL("/", site).href} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <slot name="nav" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <script>
      import { initMotion } from "../lib/motion";
      document.addEventListener("astro:page-load", initMotion);
    </script>
  </body>
</html>
