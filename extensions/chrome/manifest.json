{
  "manifest_version": 3,
  "name": "Atelier Browser Bridge",
  "version": "0.1.0",
  "description": "Read-only Chrome extension for Atelier agents to open pages and inspect cleaned HTML & computed CSS design tokens.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Atelier Browser Bridge"
  }
}
